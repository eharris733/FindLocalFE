---
// Card grid. `flat` (used by the featured sort, whose order is deliberately not
// chronological) renders one grid with no day headers; otherwise the cards are
// grouped under sticky day headers in date order.
import type { EventRow } from '@findlocal/shared';
import { dayHeader } from '../lib/format.js';
import EventCard from './EventCard.astro';
interface Props {
  events: EventRow[];
  tz: string;
  flat?: boolean;
}
const { events, tz, flat = false } = Astro.props;
const byDay = new Map<string, EventRow[]>();
for (const e of events) {
  const list = byDay.get(e.event_date) ?? [];
  list.push(e);
  byDay.set(e.event_date, list);
}
let index = 0;
---
{flat ? (
  <div class="grid flat-grid">
    {events.map((e) => <EventCard event={e} tz={tz} eager={index++ < 4} />)}
  </div>
) : [...byDay.entries()].map(([day, list]) => (
  <section class="day-group">
    <h2 class="day-header">{dayHeader(day, tz)}</h2>
    <div class="grid">
      {list.map((e) => <EventCard event={e} tz={tz} eager={index++ < 4} />)}
    </div>
  </section>
))}

<style>
  .flat-grid { margin-top: 1.5rem; }
</style>
