---
// "Books" section on a literary event page: the book(s) tied to the event via the
// gazetteer (event.book_ids → books), on a fixed grid so covers, titles and buy
// links line up down the column.
//
// The buy link is a compact text link and appears ONLY when we can deep-link the
// exact book (an ISBN-13). The vague "Shop on Bookshop.org" storefront variant was
// dropped from the event page — it added no value — but `buyLink()` in
// lib/bookshop.ts still returns it for other surfaces.
import { imageUrl, openLibraryCover, type BookRow } from '@findlocal/shared';
import { buyLink, BOOKSHOP_LINK_REL } from '../lib/bookshop.js';
import Icon from './Icon.astro';
interface Props {
  books: BookRow[];
  /** authors.id → display name, so a row can credit its author. */
  authorNames?: Record<string, string>;
}
const { books, authorNames = {} } = Astro.props;
const rows = books.map((b) => {
  const raw = openLibraryCover(b.cover_url, 'M');
  const buy = buyLink(b);
  const by = b.author_ids.map((id) => authorNames[id]).filter(Boolean).slice(0, 2).join(', ');
  return {
    book: b,
    cover: raw ? imageUrl(raw, { width: 128, height: 192, fit: 'contain' }) : null,
    buy: buy.exact ? buy : null,
    by,
  };
});
const anyBuy = rows.some((r) => r.buy);
---
<ul class="books">
  {rows.map(({ book: b, cover, buy, by }) => (
    <li class="book">
      <div class="cover">
        {cover ? (
          <img src={cover} alt={`Cover of ${b.title}`} width="64" height="96" loading="lazy" decoding="async" />
        ) : (
          <span class="ph" aria-hidden="true"><Icon name="bookmark" size={22} /></span>
        )}
      </div>
      <div class="info">
        <span class="title">{b.title}</span>
        {b.subtitle && <span class="subtitle">{b.subtitle}</span>}
        {by && <span class="by">{by}</span>}
        {buy && (
          <a class="buy" href={buy.href} rel={BOOKSHOP_LINK_REL} target="_blank">
            Buy on Bookshop.org
            <svg class="ext" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M14 3h7v7h-2V6.41l-8.29 8.3-1.42-1.42L17.59 5H14V3ZM5 5h5v2H7v10h10v-3h2v5H5V5Z" />
            </svg>
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
{anyBuy && <p class="disclosure faint">Bookshop.org funds independent bookstores. Buying through these links can earn Find Local a small commission at no extra cost to you.</p>}

<style>
  .books { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  /* One grid per row keeps every cover, title and link on the same x-axis. */
  .book { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 0.9rem; align-items: start; }
  .cover { width: 64px; height: 96px; border-radius: var(--radius-sm); overflow: hidden; background: rgb(var(--surface)); box-shadow: var(--shadow-sm); }
  .cover img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .cover .ph { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: rgb(var(--teal)); background: rgb(var(--teal) / 0.1); }
  .info { display: grid; gap: 0.2rem; min-width: 0; align-content: start; }
  .title { font-weight: 700; line-height: 1.3; }
  .subtitle { font-size: 0.85rem; color: rgb(var(--text-3)); }
  .by { font-size: 0.85rem; color: rgb(var(--text-2)); }
  .buy { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.15rem; font-size: 0.88rem; font-weight: 600; width: fit-content; }
  .buy .ext { opacity: 0.7; }
  .disclosure { font-size: 0.78rem; margin: 0.75rem 0 0; }
</style>
