---
// Coverage by metro for the landing page: every canonical metro, its live
// upcoming-event count, linking to its city page. A plain 83-row table is
// unusable on a phone, so the rows are a responsive grid of links instead
// (sorted by count, metros with nothing on the calendar last).
import { CITIES } from '@findlocal/shared';
interface Props {
  /** city name -> upcoming event count (`platformStats().eventsByCity`). */
  byCity: Map<string, number>;
  /** The visitor's current city (fl_city cookie), highlighted. */
  current?: string;
}
const { byCity, current } = Astro.props;
const rows = CITIES.map((c) => ({ city: c, n: byCity.get(c.name) ?? 0 })).sort(
  (a, b) => b.n - a.n || a.city.name.localeCompare(b.city.name),
);
const empty = rows.filter((r) => r.n === 0).length;
---
<ul class="metros">
  {rows.map(({ city, n }) => (
    <li>
      <a href={`/city/${city.slug}`} aria-current={city.name === current ? 'true' : undefined}>
        <span class="name">{city.name}<span class="st">{city.state}</span></span>
        <span class="n">{n.toLocaleString('en-US')}</span>
      </a>
    </li>
  ))}
</ul>
{empty > 0 && (
  <p class="faint note">
    {empty} metro{empty === 1 ? '' : 's'} have no upcoming listings right now — venues there are onboarded but their
    calendars are empty or newly added.
  </p>
)}

<style>
  /* Two columns even on a phone: 83 rows in one column added ~2,900px of scroll
     to the landing page, and a row is only "<city> <state> … <count>" whose name
     ellipsises rather than wraps. Three columns from 860px. */
  .metros { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 0.35rem; grid-template-columns: 1fr 1fr; column-gap: 0.9rem; }
  @media (min-width: 520px) { .metros { column-gap: 1.2rem; } }
  @media (min-width: 860px) { .metros { grid-template-columns: repeat(3, 1fr); } }
  .metros a { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; padding: 0.3rem 0.1rem; border-bottom: 1px solid rgb(var(--border)); color: rgb(var(--text)); font-size: 0.9rem; }
  .metros a:hover { text-decoration: none; color: rgb(var(--teal)); border-bottom-color: rgb(var(--teal)); }
  .metros a[aria-current='true'] { color: rgb(var(--teal)); font-weight: 700; }
  .metros .name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .metros .st { color: rgb(var(--text-3)); font-size: 0.75em; margin-left: 0.35rem; }
  .metros .n { color: rgb(var(--text-2)); font-variant-numeric: tabular-nums; font-size: 0.85rem; flex-shrink: 0; }
  .note { font-size: 0.82rem; margin-top: 0.9rem; }
</style>
