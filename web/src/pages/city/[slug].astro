---
// Canonical per-city page ("things to do in Boston"). ItemList + BreadcrumbList
// JSON-LD; noindex when filtered, thin (<3 events) or past the last page.
// Plain pagination (?page=N) is indexable with a self-referencing canonical so
// crawlers can walk the whole list; filter chips are nofollow + robots-blocked.
import Layout from '../../layouts/Layout.astro';
import Feed from '../../components/Feed.astro';
import JsonLd from '../../components/JsonLd.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CityBlurb from '../../components/CityBlurb.astro';
import { getDb } from '../../lib/db.js';
import { loadFeed } from '../../lib/feed.js';
import { approxCount } from '../../lib/format.js';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld.js';
import { SITE, cityBySlug, countUpcomingEventsWithin } from '@findlocal/shared';

const slug = Astro.params.slug ?? '';
const city = cityBySlug(slug);
if (!city) return Astro.rewrite('/404');
if (city.slug !== slug) return Astro.redirect(`/city/${city.slug}${Astro.url.search}`, 301);

const db = getDb();
// The subhead counts the next 30 days ("this month"), not every future date, so
// the one line above the fold is literally true. The long descriptive sentence
// moved to the footer blurb.
const [state, monthCount] = await Promise.all([loadFeed(db, city, Astro.url), countUpcomingEventsWithin(db, city.name, 30, city.tz)]);
const filtered = state.filterCanonical !== '';
const paged = !filtered && state.page > 1;
const thin = state.total < 3;
const beyond = state.page > state.pages;
const cityLabel = `${city.name}, ${city.state}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: `Events in ${city.name}`, path: state.basePath },
];
const jsonAlternate = `${SITE}/api/events?city=${encodeURIComponent(city.name)}${state.canonical ? `&${state.canonical}` : ''}`;
---
<Layout
  title={`Things to Do in ${city.name} — Concerts, Comedy, Theater & More${paged ? ` (Page ${state.page})` : ''}`}
  description={`Upcoming live music, comedy, theater, and community events in ${cityLabel}, pulled straight from local venue calendars and updated daily.`}
  canonicalPath={state.basePath}
  canonicalQuery={paged ? `page=${state.page}` : ''}
  noindex={filtered || thin || beyond}
  jsonAlternate={jsonAlternate}
  wide
>
  <JsonLd data={[itemListJsonLd(`Upcoming events in ${cityLabel}`, state.events, state.total), breadcrumbJsonLd(crumbs)]} slot="head" />
  <Breadcrumbs crumbs={crumbs} />
  <Feed
    state={state}
    heading={`Things to do in ${city.name}`}
    intro={filtered ? undefined : `${approxCount(monthCount)} things to do in ${city.name} this month`}
  />
  <CityBlurb city={city} />
</Layout>
