---
// /developers/pricing — plans for the JSON API + MCP server. SSR because the
// Stripe Payment Link per plan comes from env (differs test vs live). One key
// works across both the REST API and the MCP server.
import Layout from '../../layouts/Layout.astro';
import DocsNav from '../../components/DocsNav.astro';
import { PLANS } from '../../lib/plans.js';
import { getEnv } from '../../lib/db.js';
export const prerender = false;

const env = getEnv();
// Accounts-first: you create a free account to get a key, then upgrade from the
// dashboard (which starts a Stripe Checkout tied to your account). Paid plans need
// their Stripe price configured to be checkout-able.
const paidConfigured = !!(env.STRIPE_PRICE_PRO || env.STRIPE_PRICE_SCALE);
const portalUrl = env.STRIPE_PORTAL_URL;
const fmt = (n: number) => n.toLocaleString('en-US');
---
<Layout title="API Pricing" description="Plans for the FindLocal developer API and MCP server: a free tier, plus Pro and Scale for production and high-volume use. One key works across the JSON API and MCP." canonicalPath="/developers/pricing">
  <div class="docs">
    <DocsNav current="/developers/pricing" title="Pricing" />
    <h1>API &amp; MCP pricing</h1>
    <p class="lede">One account, many keys — all working across both the <a href="/developers/api">JSON API</a> and the <a href="/developers/mcp">MCP server</a>. Create a free account to get your first key, then upgrade any time. Quotas reset monthly.</p>

    <div class="plans">
      {PLANS.map((p) => (
        <div class={`plan ${p.id === 'pro' ? 'featured' : ''}`}>
          {p.id === 'pro' && <span class="badge">Most popular</span>}
          <h2>{p.name}</h2>
          <p class="price">{p.priceUsd === 0 ? 'Free' : <>${p.priceUsd}<span>/mo</span></>}</p>
          <p class="blurb">{p.blurb}</p>
          <ul class="feats">
            <li><strong>{fmt(p.monthlyQuota)}</strong> calls / month</li>
            <li>{fmt(p.perMinuteLimit)} requests / minute</li>
            <li>JSON API + MCP server</li>
            <li>All {`cities & filters`}</li>
          </ul>
          {p.priceUsd === 0
            ? <a class="cta" href="/developers/signin">Start free</a>
            : paidConfigured
              ? <a class="cta" href="/developers/signin">Get started with {p.name}</a>
              : <span class="cta disabled" aria-disabled="true">Coming soon</span>}
        </div>
      ))}
    </div>

    {!paidConfigured && (
      <div class="note"><p><strong>Setup pending:</strong> paid plans aren't configured yet. Set <code>STRIPE_PRICE_PRO/SCALE</code> (and the webhook + Unkey secrets) to go live.</p></div>
    )}

    <h2 id="manage">Manage your account</h2>
    <p>Create and revoke keys, track usage, and upgrade or downgrade any time from your
      <a href="/developers/dashboard">developer dashboard</a>.
      {portalUrl && <> Card changes and cancellations happen in the <a href={portalUrl}>Stripe customer portal</a>, linked from your dashboard.</>}</p>

    <h2 id="how">How it works</h2>
    <ul>
      <li>Send your key as a bearer token: <code>Authorization: Bearer &lt;key&gt;</code> (or the <code>x-api-key</code> header).</li>
      <li>For MCP, paste the key when you connect <code>mcp.findlocal.community/mcp</code>.</li>
      <li>Over your rate limit returns <code>429</code>; over your monthly quota also returns <code>429</code> — upgrade to continue.</li>
      <li>The embeddable <a href="/developers/widgets">widgets</a> stay free and need no key.</li>
    </ul>
  </div>
</Layout>

<style>
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 1.4rem 0 1.5rem; }
  .plan { position: relative; border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 1.4rem 1.3rem; background: rgb(var(--surface)); display: flex; flex-direction: column; }
  .plan.featured { border-color: rgb(var(--teal)); box-shadow: 0 0 0 1px rgb(var(--teal)); }
  .plan h2 { margin: 0 0 0.2rem; }
  .badge { position: absolute; top: -0.7rem; left: 1.3rem; background: rgb(var(--teal)); color: rgb(var(--text-inverse)); font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; }
  .price { font-size: 2rem; font-weight: 800; margin: 0.2rem 0 0.4rem; color: rgb(var(--text)); }
  .price span { font-size: 1rem; font-weight: 600; color: rgb(var(--text-2)); }
  .blurb { margin: 0 0 0.8rem; font-size: 0.92rem; }
  .feats { list-style: none; padding: 0; margin: 0 0 1.2rem; }
  .feats li { padding: 0.3rem 0; border-bottom: 1px solid rgb(var(--border)); font-size: 0.9rem; }
  .feats li:last-child { border-bottom: 0; }
  .cta { margin-top: auto; display: block; text-align: center; padding: 0.65rem 1rem; border-radius: 999px; font-weight: 700; background: rgb(var(--teal)); color: rgb(var(--text-inverse)); text-decoration: none; }
  .cta:hover { text-decoration: none; opacity: 0.92; }
  .cta.disabled { background: rgb(var(--surface-sunken)); color: rgb(var(--text-2)); cursor: not-allowed; }
</style>
