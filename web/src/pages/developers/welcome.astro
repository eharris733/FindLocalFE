---
// /developers/welcome — post-checkout confirmation, set as the Stripe Payment
// Link success URL (`?session_id={CHECKOUT_SESSION_ID}`). SSR + noindex. It
// fetches the checkout session with the secret key (so it only ever confirms a
// real, paid session) and reassures the customer that their key is on its way by
// email. It deliberately does NOT show the key: the key is minted+emailed by the
// billing webhook, and Unkey reveals plaintext only once, at creation. Showing it
// here (and self-serve rotate / resend) needs the identity work noted in
// docs/MONETIZATION_SETUP.md — a fast follow, not this page.
import Layout from '../../layouts/Layout.astro';
import { getEnv } from '../../lib/db.js';
import { stripeGet } from '../../lib/stripe.js';
import { PLAN_BY_ID, planForStripePrice } from '../../lib/plans.js';
export const prerender = false;

const env = getEnv();
const portalUrl = env.STRIPE_PORTAL_URL;
const sessionId = Astro.url.searchParams.get('session_id');

let planName: string | undefined;
let paid = false;

if (sessionId && env.STRIPE_SECRET_KEY) {
  try {
    const s = await stripeGet(env.STRIPE_SECRET_KEY, `/v1/checkout/sessions/${sessionId}`, ['line_items']);
    paid = s.payment_status === 'paid' || s.status === 'complete';
    const byMeta = PLAN_BY_ID.get(s.metadata?.plan);
    const priceId = s.line_items?.data?.[0]?.price?.id as string | undefined;
    planName = (byMeta ?? planForStripePrice(priceId, env as unknown as Record<string, string | undefined>))?.name;
  } catch {
    // Network/lookup hiccup — fall back to the generic confirmation below.
  }
}
---
<Layout
  title="Welcome"
  description="Your FindLocal API subscription is confirmed."
  canonicalPath="/developers/welcome"
  noindex={true}
>
  <div class="docs">
    <div class="card">
      <div class="check" aria-hidden="true">✓</div>
      <h1>{paid ? <>You're in{planName ? <> — welcome to {planName}</> : null}!</> : 'Payment received'}</h1>

      <p class="lede">
        {planName ? <>Your <strong>{planName}</strong> plan is active.</> : <>Your subscription is active.</>}
        {' '}Head to your dashboard to create and manage your API keys.
      </p>

      <div class="next">
        <a class="cta" href="/developers/dashboard/keys">Create your API key</a>
        <a class="cta ghost" href="/developers/api">Read the API docs</a>
      </div>

      <div class="note">
        <p>Manage keys, usage and billing any time from your
          <a href="/developers/dashboard">developer dashboard</a>.
          {portalUrl
            ? <> Card changes and cancellations happen in the <a href={portalUrl}>customer portal</a>.</>
            : null}
          Questions? Email <a href="mailto:findlocalinternal@gmail.com">findlocalinternal@gmail.com</a>.</p>
      </div>

      <p class="fine">Your keys work across both the JSON API and the MCP server. Send a key as
        <code>Authorization: Bearer &lt;key&gt;</code>. Quotas reset monthly and are shared across your keys.</p>
    </div>
  </div>
</Layout>

<style>
  .card {
    max-width: 640px; margin: 1.5rem auto; padding: 2rem 1.8rem;
    border: 1px solid rgb(var(--border)); border-radius: var(--radius);
    background: rgb(var(--surface)); text-align: center;
  }
  .check {
    width: 3rem; height: 3rem; margin: 0 auto 1rem; border-radius: 999px;
    background: rgb(var(--teal)); color: rgb(var(--text-inverse));
    font-size: 1.6rem; font-weight: 800; line-height: 3rem;
  }
  .card h1 { margin: 0 0 0.6rem; }
  .lede { font-size: 1.05rem; color: rgb(var(--text-2)); margin: 0 0 1.4rem; }
  .next { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .cta {
    display: inline-block; padding: 0.65rem 1.2rem; border-radius: 999px; font-weight: 700;
    background: rgb(var(--teal)); color: rgb(var(--text-inverse)); text-decoration: none;
  }
  .cta:hover { text-decoration: none; opacity: 0.92; }
  .cta.ghost { background: transparent; color: rgb(var(--teal)); box-shadow: inset 0 0 0 1px rgb(var(--teal)); }
  .note {
    text-align: left; background: rgb(var(--surface-sunken)); border-radius: var(--radius);
    padding: 0.9rem 1.1rem; margin: 0 0 1.2rem; font-size: 0.92rem;
  }
  .note p { margin: 0; }
  .fine { font-size: 0.85rem; color: rgb(var(--text-2)); margin: 0; }
</style>
