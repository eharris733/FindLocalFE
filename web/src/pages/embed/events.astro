  .fl-icon-btn:hover { border-color: rgb(var(--teal)); }
  .fl-places { position: absolute; z-index: 20; top: 100%; left: 0; right: 0; margin: 0.15rem 0 0; padding: 0.2rem; list-style: none; background: rgb(var(--surface)); border: 1px solid rgb(var(--border-2)); border-radius: var(--radius-sm); box-shadow: var(--shadow-md); max-height: 12rem; overflow-y: auto; }
  .fl-places li { padding: 0.3rem 0.45rem; border-radius: var(--radius-sm); font-size: 0.8rem; cursor: pointer; }
  .fl-places li:hover, .fl-places li:focus { background: rgb(var(--teal-50)); }
