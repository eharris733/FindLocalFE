  .fl-cal-btn:disabled { opacity: 0.35; cursor: default; }
  .fl-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  :global(.fl-cal-dow) { text-align: center; font-size: 0.7rem; font-weight: 700; color: rgb(var(--text-3)); padding: 0.2rem 0; }
