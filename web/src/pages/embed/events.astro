  .fl-row:last-child, :global(.fl-row:last-child) { border-bottom: 0; }
  .fl-time, :global(.fl-time) { color: rgb(var(--orange)); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; padding-top: 0.15rem; }
  .fl-thumb, :global(.fl-thumb) { display: flex; align-items: center; justify-content: center; width: 48px; height: 64px; border-radius: 6px; overflow: hidden; background: rgb(var(--surface-sunken)); color: rgb(var(--text-3)); box-shadow: inset 0 0 0 1px rgb(var(--border) / 0.6); }
  .fl-thumb img, :global(.fl-thumb img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fl-thumb img.cover, :global(.fl-thumb img.cover) { object-fit: contain; }
  .fl-main, :global(.fl-main) { min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .fl-title, :global(.fl-title) { font-family: var(--font-head); font-weight: 600; color: rgb(var(--text)); line-height: 1.25; }
  .fl-with, :global(.fl-with) { color: rgb(var(--text-2)); font-size: 0.82rem; line-height: 1.3; }
  .fl-with a, :global(.fl-with a) { color: rgb(var(--teal)); font-weight: 600; }
  .fl-where, :global(.fl-where) { color: rgb(var(--text-2)); font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fl-pills, :global(.fl-pills) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; margin-top: 0.3rem; }
  .fl-price, :global(.fl-price) { display: inline-flex; padding: 0.16rem 0.5rem; border-radius: 999px; background: rgb(var(--surface-sunken)); color: rgb(var(--text-2)); font-size: 0.72rem; font-weight: 700; line-height: 1.2; }
  .fl-price.free, :global(.fl-price.free) { background: rgb(var(--teal-50)); color: rgb(var(--teal)); }
  .fl-empty, :global(.fl-empty) { color: rgb(var(--text-2)); padding: 1rem 0; margin: 0; }
  .fl-more, :global(.fl-more) { color: rgb(var(--text-2)); font-size: 0.85rem; margin: 0.8rem 0 0; }
  .fl-buy, :global(.fl-buy) { display: inline-flex; align-items: center; padding: 0.18rem 0.6rem; border: 1px solid rgb(var(--orange)); border-radius: 999px; font-size: 0.74rem; font-weight: 700; line-height: 1.2; color: rgb(var(--orange)); }
  .fl-buy:hover, :global(.fl-buy:hover) { text-decoration: none; background: rgb(var(--orange)); color: rgb(var(--text-inverse)); }
  .fl-support { margin: 1rem 0 0; padding-top: 0.8rem; border-top: 1px solid rgb(var(--border)); font-size: 0.82rem; color: rgb(var(--text-2)); }
  .fl-support a { color: rgb(var(--orange)); font-weight: 700; }
  code { background: rgb(var(--surface-sunken)); padding: 0 0.3rem; border-radius: 4px; }
