/*
  Cross-Origin-Resource-Policy: cross-origin

# Content-hashed Metro bundles and chunks — safe to cache forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed exported assets. Pages sets MIME types itself; keep a single
# matching rule per path so headers aren't comma-joined/duplicated.
/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted woff2 fonts (declared in scripts/inject-head.js).
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Unhashed brand asset; short TTL so a swap propagates within a day.
/logo.webp
  Cache-Control: public, max-age=86400
