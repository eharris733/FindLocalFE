{
  "expo": {
    "name": "Find Local",
    "slug": "find-local-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "findlocal",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.findlocalmobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006B5E"
      },
      "package": "com.anonymous.findlocalmobile"
    },
    "web": {
      "favicon": "./assets/monocle.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@expo-google-fonts/work-sans"
          ]
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/work-sans/WorkSans_300Light.ttf",
            "node_modules/@expo-google-fonts/work-sans/WorkSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/work-sans/WorkSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/work-sans/WorkSans_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/work-sans/WorkSans_700Bold.ttf"
          ]
        }
      ]
    ]
  }
}
