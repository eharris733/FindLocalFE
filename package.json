{
  "name": "find-local-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/inject-head.js && cp -f public/_headers dist/_headers && cp -f public/_redirects dist/_redirects",
    "build:web": "expo export --platform web && node scripts/inject-head.js && cp -f public/_headers dist/_headers && cp -f public/_redirects dist/_redirects",
    "serve": "expo export --platform web && node scripts/inject-head.js && cp -f public/_headers dist/_headers && cp -f public/_redirects dist/_redirects && npx serve dist"
  },
  "dependencies": {
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.50.5",
    "@tanstack/react-query": "^5.90.20",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "date-fns": "^4.1.0",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.7",
    "expo-auth-session": "^7.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.9",
    "expo-font": "~14.0.9",
    "expo-image-picker": "^17.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "jsonwebtoken": "^9.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.2.3",
    "typescript": "~5.9.2"
  }
}
